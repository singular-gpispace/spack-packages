diff --git a/GPISpaceConfig.cmake.in b/GPISpaceConfig.cmake.in
index c11cb9d..817d61a 100644
--- a/GPISpaceConfig.cmake.in
+++ b/GPISpaceConfig.cmake.in
@@ -158,10 +158,13 @@ get_property (_current_options
   TARGET Boost::program_options
   PROPERTY INTERFACE_LINK_OPTIONS
 )
-set (_boost_po_link_workaround
-  "LINKER:--exclude-libs,libboost_program_options.a"
-)
-if (NOT _boost_po_link_workaround IN_LIST _current_options)
+set (_boost_po_link_workaround)
+if (NOT APPLE)
+  set (_boost_po_link_workaround
+    "LINKER:--exclude-libs,libboost_program_options.a"
+  )
+endif()
+if (_boost_po_link_workaround AND NOT _boost_po_link_workaround IN_LIST _current_options)
