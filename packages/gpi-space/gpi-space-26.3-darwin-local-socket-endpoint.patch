     namespace gspc::rpc::detail
     {
+#ifdef __APPLE__
+      inline constexpr char generated_socket_path_prefix[]
+        = "/tmp/gspc-rpc-";
+
+      inline ::boost::asio::local::stream_protocol::endpoint
+        stream_provider_endpoint
+          (::boost::asio::local::stream_protocol::endpoint endpoint)
+      {
+        if (endpoint.path().empty())
+        {
+          static std::atomic<unsigned long> counter {0};
+
+          std::string const path
+            ( std::string (generated_socket_path_prefix)
+            + std::to_string (::getpid())
+            + "-"
+            + std::to_string (counter++)
+            + ".sock"
+            );
+
+          ::unlink (path.c_str());
+
+          return ::boost::asio::local::stream_protocol::endpoint (path);
+        }
+
+        return endpoint;
+      }
+#endif
+
+      template<typename Endpoint>
+        Endpoint stream_provider_endpoint (Endpoint endpoint)
+      {
+        return endpoint;
+      }
+
+#ifdef __APPLE__
+      inline void cleanup_stream_provider_endpoint
+        (::boost::asio::local::stream_protocol::endpoint const& endpoint)
+      {
+        std::string const path (endpoint.path());
+
+        if (path.compare ( 0
+                         , sizeof (generated_socket_path_prefix) - 1
+                         , generated_socket_path_prefix
+                         ) == 0)
+        {
+          ::unlink (path.c_str());
+        }
+      }
+#endif
+
+      template<typename Endpoint>
+        void cleanup_stream_provider_endpoint (Endpoint const&)
+      {}
