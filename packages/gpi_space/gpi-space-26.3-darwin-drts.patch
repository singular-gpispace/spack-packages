diff --git a/cmake/FindHWLOC.cmake b/cmake/FindHWLOC.cmake
index 53ec0b0..35a5fc3 100644
--- a/cmake/FindHWLOC.cmake
+++ b/cmake/FindHWLOC.cmake
@@ -18,6 +18,21 @@ include (detail/pkgconfig_helper)

 _pkgconfig_find_library_module (${_pkgname} ${_libnamespace} ${_libname})

+if (APPLE AND TARGET ${_libnamespace}-${_libname})
+  find_library (_HWLOC_COREFOUNDATION_FRAMEWORK CoreFoundation)
+  find_library (_HWLOC_IOKIT_FRAMEWORK IOKit)
+
+  if (NOT _HWLOC_COREFOUNDATION_FRAMEWORK OR NOT _HWLOC_IOKIT_FRAMEWORK)
+    message (FATAL_ERROR "Could not find frameworks required by hwloc on Darwin")
+  endif()
+
+  target_link_libraries (${_libnamespace}-${_libname}
+    INTERFACE
+      ${_HWLOC_COREFOUNDATION_FRAMEWORK}
+      ${_HWLOC_IOKIT_FRAMEWORK}
+  )
+endif()
+



